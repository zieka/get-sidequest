---
import { getImage } from 'astro:assets';
import VillageCanvas from '../village/VillageCanvas';
import backdrop from '../../assets/village/background.png';
import supervisor from '../../assets/sprites/supervisor.png';
import chronicler from '../../assets/sprites/chronicler.png';
import courier from '../../assets/sprites/courier.png';

const base = import.meta.env.BASE_URL;
const downloadUrl = "https://github.com/zieka/get-sidequest/releases/latest";
const docsUrl = `${base}docs/`;

// Same URL for the poster and the WebGL texture, so the scene reuses the cached file
const poster = await getImage({ src: backdrop, format: 'webp', quality: 80 });
const sprite = async (src: ImageMetadata) => (await getImage({ src, width: 128, format: 'webp' })).src;
const assets = {
  backdrop: poster.src,
  supervisor: await sprite(supervisor),
  chronicler: await sprite(chronicler),
  courier: await sprite(courier),
};
---

<section class="relative overflow-hidden h-screen min-h-[600px] max-h-[900px] bg-background">
  <!-- First paint, phones and reduced motion; the WebGL scene fades in over it on desktop -->
  <img
    src={poster.src}
    width={backdrop.width}
    height={backdrop.height}
    alt=""
    loading="eager"
    fetchpriority="high"
    decoding="async"
    class="hero-poster"
  />

  <VillageCanvas client:only="react" assets={assets} />

  <!-- Dark gradient overlay for text readability -->
  <div class="absolute inset-0 bg-gradient-to-t from-background via-background/40 to-transparent pointer-events-none"></div>

  <!-- Text overlay -->
  <div class="relative z-10 flex flex-col items-center justify-center h-full px-6 text-center">
    <h1 class="font-display text-4xl md:text-6xl tracking-tight leading-[1.3] mb-6 hero-text">
      Your main quest is always running.<br />
      But every great adventure needs
      <span class="font-heading">sidequests.</span>
    </h1>

    <p class="text-lg md:text-xl text-gray-300 max-w-2xl mx-auto mb-10 leading-relaxed hero-text">
      Orchestrate multiple parallel agents to tackle bugs, ship features, and research solutions, because sometimes it takes a village.
    </p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <a href={downloadUrl} class="inline-flex items-center px-6 py-3 rounded-xl text-base font-medium text-white bg-gradient-to-r from-brand-pink to-brand-magenta hover:opacity-90 transition-opacity shadow-brand">
        Download for macOS &amp; Linux
      </a>
      <a href={docsUrl} class="inline-flex items-center px-6 py-3 rounded-xl text-base font-medium text-gray-300 border border-white/10 hover:border-white/20 hover:text-white transition-all">
        Read the docs
      </a>
    </div>
  </div>
</section>

<style>
  .hero-text {
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.8), 0 4px 24px rgba(0, 0, 0, 0.6);
  }

  .hero-poster {
    position: absolute;
    left: 50%;
    top: 50%;
    width: auto;
    max-width: none;
    height: 100%;
    transform: translate(-50%, -50%);
  }

  /* Matches the WebGL framing in Backdrop.tsx: 1.273× zoom, growing past ~2.2:1 to cover the
     width plus camera truck (3 units ≈ 10.91% of hero height; 1.8286 is the plane's aspect) */
  @media (min-width: 768px) {
    .hero-poster {
      height: max(127.3%, calc((100vw + 10.91%) / 1.8286));
    }
  }
</style>
