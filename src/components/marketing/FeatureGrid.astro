---
const items = [
  'Recurring quest scheduling',
  'Council second opinion',
  'Claude, Gemini, Codex, Copilot & OpenCode',
  'Smart model router',
  'Multiple Claude accounts',
  'Per-quest token budgets',
  'Diff viewer with find',
  'Context handoffs between quests',
  'Review quests for pull requests',
  'GitHub issues & PR badges',
  'Per-project setup commands',
  'Keyboard shortcuts & command palette',
  'Custom extensions & panels',
  'Cost estimator',
  'Dark & light modes',
  'English, French, Spanish & Chinese',
  'Git log & client operations',
  'Quick open to editor, terminal & remote',
  'A CLI your agents can use',
  'macOS & Linux',
];
---

<section class="relative px-6 py-24">
  <div class="mx-auto max-w-5xl">
    <h2 class="font-heading text-3xl md:text-4xl tracking-tight text-center mb-12">And so much more</h2>

    <!-- Wrapping flex rather than grid so a short last row centers instead of leaving holes -->
    <ul class="flex flex-wrap justify-center gap-4">
      {items.map((item) => (
        <li class="flex items-center justify-center basis-[calc(50%-0.5rem)] sm:basis-[calc(33.333%-0.667rem)] md:basis-[calc(25%-0.75rem)] rounded-xl border border-white/5 bg-white/[0.02] px-4 py-5 text-center text-sm text-gray-300">
          {item}
        </li>
      ))}
    </ul>
  </div>
</section>
