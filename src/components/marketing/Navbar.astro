---
import { Image } from 'astro:assets';
import appIcon from '../../assets/app-icon.png';

const base = import.meta.env.BASE_URL;
---

<nav class="fixed top-0 left-0 right-0 z-50 border-b border-white/5 backdrop-blur-xl bg-background/70">
  <div class="mx-auto max-w-7xl px-6 flex items-center justify-between h-16">
    <a href={base} class="flex shrink-0 items-center gap-3 py-3">
      <Image src={appIcon} alt="" width={32} densities={[1, 2]} loading="eager" class="w-8 h-8 rounded-lg" />
      <span class="font-heading text-lg text-white">Sidequest</span>
    </a>
    <div class="flex items-center gap-5 md:gap-8">
      <a href="#features" class="hidden sm:inline py-3 text-sm text-gray-400 hover:text-white transition-colors">Features</a>
      <a href={`${base}docs/`} class="py-3 text-sm text-gray-400 hover:text-white transition-colors">Docs</a>
      <a href="https://github.com/zieka/get-sidequest" class="py-3 text-sm text-gray-400 hover:text-white transition-colors">GitHub</a>
      <a
        href="https://github.com/zieka/get-sidequest/releases/latest"
        class="hidden sm:inline-flex items-center px-4 py-2 rounded-lg text-sm font-medium text-gray-200 border border-white/15 hover:border-white/30 hover:text-white transition-colors"
      >
        Download
      </a>
    </div>
  </div>
</nav>
