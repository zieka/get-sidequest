---
import { Image } from 'astro:assets';
import MarketingLayout from '../layouts/MarketingLayout.astro';
import Navbar from '../components/marketing/Navbar.astro';
import Hero from '../components/marketing/Hero.astro';
import Problem from '../components/marketing/Problem.astro';
import Features from '../components/marketing/Features.astro';
import FeatureGrid from '../components/marketing/FeatureGrid.astro';
import DownloadCTA from '../components/marketing/DownloadCTA.astro';
import Footer from '../components/marketing/Footer.astro';
import appScreenshot from '../assets/screenshots/sidequest.png';
---

<MarketingLayout
  title="Sidequest — Your AI development team, orchestrated."
  description="Run parallel Claude Code agents, supervise them automatically, and ship faster than ever."
>
  <Navbar />
  <main class="pt-16">
    <Hero />
    <Problem />
    <section class="relative px-6 pt-8 pb-24">
      <div class="mx-auto max-w-5xl">
        <h2 class="font-heading text-3xl md:text-4xl tracking-tight text-center text-balance mb-12">
          The next generation of IDE for commanding your agentic team.
        </h2>
        <Image
          src={appScreenshot}
          alt="Sidequest window: workspaces sidebar, a quest log of active and backlog quests, and a Claude Code session adding rate limiting to an API endpoint"
          widths={[640, 1024, 1536, 2048]}
          sizes="(min-width: 1072px) 1024px, calc(100vw - 48px)"
          class="rounded-xl border border-white/10 shadow-2xl w-full h-auto"
        />
      </div>
    </section>
    <Features />
    <FeatureGrid />
    <DownloadCTA />
  </main>
  <Footer />
</MarketingLayout>
